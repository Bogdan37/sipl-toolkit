

Program         = Statement ;

Statement       = Sequence ;

Sequence        = SimpleStatement , { ";" , SimpleStatement } ;

SimpleStatement = SkipStmt
                | AssignStmt
                | IfStmt
                | WhileStmt
                | BlockStmt ;

SkipStmt        = "skip" ;

AssignStmt      = Identifier , ":=" , ArithExpr ;

IfStmt          = "if" , BoolExpr , "then" , SimpleStatement , [ "else" , SimpleStatement ] ;

WhileStmt       = "while" , BoolExpr , "do" , SimpleStatement ;

BlockStmt       = "begin" , Statement , "end" ;


ArithExpr       = Term , { ( "+" | "-" ) , Term } ;

Term            = Factor , { ( "*" | "/" | "%" ) , Factor } ;

Factor          = [ "-" ] , Primary ;

Primary         = Number
                | Identifier
                | "(" , ArithExpr , ")" ;


BoolExpr        = BoolTerm , { "or" , BoolTerm } ;

BoolTerm        = BoolFactor , { "and" , BoolFactor } ;

BoolFactor      = "not" , BoolFactor
                | "(" , BoolExpr , ")"
                | BoolLiteral
                | Comparison ;

Comparison      = ArithExpr , RelOp , ArithExpr ;

RelOp           = "=" | "<>" | "!=" | "<" | "<=" | ">" | ">=" ;

BoolLiteral     = "true" | "false" ;


Identifier      = Letter , { Letter | Digit | "_" } ;
Number          = Digit , { Digit } ;

Letter          = "A".."Z" | "a".."z" ;
Digit           = "0".."9" ;

